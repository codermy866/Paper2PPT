[Unit]
Description=Paper2PPT API server (port 8001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data2/hmy_pri/paper2ppt/agent
ExecStart=/usr/bin/python3 -m uvicorn api_server:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
StandardOutput=append:/data2/hmy_pri/paper2ppt/agent/runtime/logs/api.log
StandardError=append:/data2/hmy_pri/paper2ppt/agent/runtime/logs/api.log

[Install]
WantedBy=default.target
